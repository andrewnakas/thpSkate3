+// thpSkate3: on-request capture of the presented game frame (RT64_RequestScreenshot), written as a binary PPM.
+namespace RT64 {
+    static std::mutex screenshotMutex;
+    static std::string screenshotPath;
+    static std::atomic<bool> screenshotRequested{ false };
+
+    // thpSkate3: a host-drawn ImGui overlay. With overlay-only on, State::inspect draws just this callback inside
+    // the inspector's ImGui frame instead of RT64's debugging windows.
+    static std::atomic<void (*)()> overlayDraw{ nullptr };
+    static std::atomic<bool> overlayOnly{ false };
+    void SetOverlay(void (*draw)()) { overlayDraw = draw; }
+    void SetOverlayOnly(bool on) { overlayOnly = on; }
+    bool OverlayOnly() { return overlayOnly; }
+    void DrawOverlay() {
+        if (void (*draw)() = overlayDraw.load()) {
+            draw();
+        }
+    }
+
+    void RequestScreenshot(const char *path) {
+        const std::scoped_lock lock(screenshotMutex);
+        screenshotPath = path;
+        screenshotRequested = true;
+    }
+
+    static float halfToFloat(uint16_t h) {
+        const uint32_t s = (h >> 15) & 1, e = (h >> 10) & 0x1F, m = h & 0x3FF;
+        float v = (e == 0) ? (m / 1024.0f) * (1.0f / 16384.0f) : (e == 31 ? 1.0f : (1.0f + m / 1024.0f) * float(1u << e) / 32768.0f);
+        return s ? -v : v;
+    }
+
+    static void writeScreenshot(const uint8_t *data, RenderFormat format, uint32_t width, uint32_t height, uint32_t rowWidth, const std::string &path) {
+        FILE *f = std::fopen(path.c_str(), "wb");
+        if (f == nullptr) {
+            return;
+        }
+        std::fprintf(f, "P6\n%u %u\n255\n", width, height);
+        std::string row(width * 3, '\0');
+        for (uint32_t y = 0; y < height; y++) {
+            for (uint32_t x = 0; x < width; x++) {
+                uint8_t rgb[3] = {};
+                if ((format == RenderFormat::R16G16B16A16_UNORM) || (format == RenderFormat::R16G16B16A16_FLOAT)) {
+                    const uint16_t *p = reinterpret_cast<const uint16_t *>(data) + (size_t(y) * rowWidth + x) * 4;
+                    for (int c = 0; c < 3; c++) {
+                        float v = (format == RenderFormat::R16G16B16A16_FLOAT) ? halfToFloat(p[c]) : p[c] / 65535.0f;
+                        v = v < 0.0f ? 0.0f : (v > 1.0f ? 1.0f : v);
+                        rgb[c] = uint8_t(v * 255.0f + 0.5f);
+                    }
+                }
+                else {
+                    const uint8_t *p = data + (size_t(y) * rowWidth + x) * 4;
+                    const bool bgr = (format == RenderFormat::B8G8R8A8_UNORM);
+                    rgb[0] = p[bgr ? 2 : 0];
+                    rgb[1] = p[1];
+                    rgb[2] = p[bgr ? 0 : 2];
+                }
+                row[x * 3 + 0] = char(rgb[0]);
+                row[x * 3 + 1] = char(rgb[1]);
+                row[x * 3 + 2] = char(rgb[2]);
+            }
+            std::fwrite(row.data(), 1, row.size(), f);
+        }
+        std::fclose(f);
+        std::fprintf(stderr, "[rt64] screenshot written to %s (%ux%u)\n", path.c_str(), width, height);
+    }
+};
