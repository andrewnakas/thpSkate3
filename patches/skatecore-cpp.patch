+
+namespace s3::game::driver {
+
+void Sim::set_tuning(const trainer::TrainerTuning& tuning, float gravity_scale) {
+    if (!s_->physics) return;
+    GamePhysics& physics = *s_->physics;
+    physics.trainer = tuning;
+    auto& g = physics.settings.step.simulation.gravity_acceleration;
+    if (!s_->base_gravity) s_->base_gravity = g;
+    g = sc::math::Vector3::new_(s_->base_gravity->x * gravity_scale, s_->base_gravity->y * gravity_scale,
+                                s_->base_gravity->z * gravity_scale);
+}
+
+void Sim::set_thps_vert(float max_ground_normal_y) {
+    if (s_->skater) s_->skater->trajectory.settings.thps_vert_max_ground_normal_y = max_ground_normal_y;
+}
+
+trainer::TrainerTuning Sim::tuning() const {
+    return s_->physics ? s_->physics->trainer : trainer::TrainerTuning{};
+}
+
+}  // namespace s3::game::driver
