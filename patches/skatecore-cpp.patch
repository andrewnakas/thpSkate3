 bool adjust_velocity(LaunchInfo& info, SelectorInput input, const SelectorSettings& s) {
     const Vector n = input.ground_normal;
+    if (n[1] > 0.02f && n[1] < s.thps_vert_max_ground_normal_y) {  // thpSkate3: THPS vert
+        const float h = std::sqrt(n[0] * n[0] + n[2] * n[2]);
+        Vector v = info.start_velocity;
+        const float k = -(v[0] * n[0] + v[2] * n[2]) / h;  // horizontal speed toward the ramp's top
+        if (h > 0.0f && k > 0.0f && v[1] > 0.0f) {
+            v[0] += n[0] / h * k;
+            v[2] += n[2] / h * k;
+            v[1] = std::sqrt(v[1] * v[1] + k * k);
+            info.start_velocity = v;
+            return true;
+        }
+    }
